# ─── App ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/calofit

# ─── JWT ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_min_32_chars_access_secret_key
JWT_REFRESH_SECRET=change_me_min_32_chars_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── AI ──────────────────────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ─── Storage ─────────────────────────────────────────────
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_BUCKET=food-images

# ─── CORS ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3001
